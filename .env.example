# Copy to .env (or export in your shell). No secrets are required by this service.
# Note: Node does not load .env automatically; use `node --env-file=.env src/server.js` (Node >= 20.6)
# or set variables in your shell / container runtime.

# Interface to bind. Keep 127.0.0.1 for local-only access; use 0.0.0.0 inside containers.
HOST=127.0.0.1
PORT=3001
# JSON data file (relative paths resolve from the project root).
DATA_FILE=data/tasks.json
# Max request body size in bytes.
BODY_LIMIT_BYTES=65536
# Max time to receive a full request.
REQUEST_TIMEOUT_MS=15000
# Set to false to disable one-line JSON request logs.
LOG_REQUESTS=true